{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Moverte entre modalidades",
    "bold": true,
    "color": "aqua"
  },
  "body": {
    "type": "minecraft:plain_message",
    "width": 360,
    "contents": {
      "text": "Cada modalidad tiene su propio inventario y su propia economia. El menu de modalidades es la forma recomendada de saltar entre ellas."
    }
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "warp_name",
      "label": {
        "text": "Nombre del warp:"
      }
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Menu de modalidades (/modalidades)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/modalidades"
      }
    },
    {
      "label": {
        "text": "Ir a Slimefun (/survival)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/survival"
      }
    },
    {
      "label": {
        "text": "Tu isla de SkyBlock (/island)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/island"
      }
    },
    {
      "label": {
        "text": "Comandos de SkyBlock"
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "drakescraft:isla_sky_menu"
      }
    },
    {
      "label": {
        "text": "Tu isla de OneBlock (/ob)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/ob"
      }
    },
    {
      "label": {
        "text": "Comandos de OneBlock"
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "drakescraft:isla_ob_menu"
      }
    },
    {
      "label": {
        "text": "Punto aleatorio (/rtp)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/rtp"
      }
    },
    {
      "label": {
        "text": "Warps publicos (/warps)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/warps"
      }
    },
    {
      "label": {
        "text": "Ir a un warp (/warp)"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "warp $(warp_name)"
      }
    },
    {
      "label": {
        "text": "Warps de jugadores (/pw)"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/pw"
      }
    },
    {
      "label": {
        "text": "Abrir tu propio warp (/pw set)"
      },
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "pw set $(warp_name)"
      }
    },
    {
      "label": {
        "text": "Volver al menu principal"
      },
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "drakescraft:main_menu"
      }
    }
  ]
}
